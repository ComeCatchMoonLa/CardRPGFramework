{
  // 让 Explorer 自动读取 .gitignore，隐藏 Library/Temp/Logs 等生成目录
  // 无需在这里重复维护一份列表
  "explorer.excludeGitIgnore": true,
  // 搜索面板 + 快速打开（Ctrl/Cmd+P）也遵循 .gitignore（多数版本默认已是 true，这里显式声明）
  "search.useIgnoreFiles": true,
  "files.exclude": {
    // git 已跟踪、人日常几乎不会打开；Agent 不受这里限制
    "**/*.meta": true,
    "ProjectSettings/*.asset": true,
    "Assets/Settings/**/*.asset": true,
    "Assets/TextMesh Pro/Fonts": true,
    "Assets/TextMesh Pro/Resources/Fonts & Materials": true,
    "Assets/TextMesh Pro/Shaders": true
  },
  "search.exclude": {
    "**/*.meta": true,
    "ProjectSettings/*.asset": true,
    "Assets/Settings/**/*.asset": true,
    "Assets/TextMesh Pro/Fonts": true,
    "Assets/TextMesh Pro/Resources/Fonts & Materials": true,
    "Assets/TextMesh Pro/Shaders": true
  },
}